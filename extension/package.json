{
  "name": "traceai",
  "displayName": "TraceAI",
  "description": "Track AI conversation provenance for code - see which Claude Code prompts generated your code",
  "version": "0.0.1",
  "publisher": "traceai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/umarkhan135/TraceAI"
  },
  "bugs": {
    "url": "https://github.com/umarkhan135/TraceAI/issues"
  },
  "homepage": "https://github.com/umarkhan135/TraceAI#readme",
  "keywords": [
    "ai",
    "claude",
    "provenance",
    "git",
    "code-tracking",
    "conversation",
    "gist",
    "claude-code"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "TraceAI",
      "properties": {
        "traceai.enableHover": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover tooltips showing AI prompt provenance"
        },
        "traceai.enableInlineDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show inline annotations (GitLens-style) at the end of AI-generated lines"
        },
        "traceai.cacheExpiration": {
          "type": "number",
          "default": 3600,
          "description": "Cache expiration time in seconds"
        },
        "traceai.showGutterIcons": {
          "type": "boolean",
          "default": false,
          "description": "Show gutter icons for AI-generated code"
        },
        "traceai.showFileStats": {
          "type": "boolean",
          "default": true,
          "description": "Show AI generation stats in file explorer"
        }
      }
    },
    "commands": [
      {
        "command": "traceai.processLatest",
        "title": "TraceAI: Process Latest Conversation"
      },
      {
        "command": "traceai.processUnpushed",
        "title": "TraceAI: Process Unpushed Commits"
      },
      {
        "command": "traceai.syncOffline",
        "title": "TraceAI: Sync Offline Artifacts"
      },
      {
        "command": "traceai.installHook",
        "title": "TraceAI: Install Git Hook"
      },
      {
        "command": "traceai.uninstallHook",
        "title": "TraceAI: Uninstall Git Hook"
      },
      {
        "command": "traceai.checkHookStatus",
        "title": "TraceAI: Check Hook Status"
      },
      {
        "command": "traceai.signIn",
        "title": "TraceAI: Sign In to GitHub"
      },
      {
        "command": "traceai.signOut",
        "title": "TraceAI: Sign Out"
      },
      {
        "command": "traceai.checkAuth",
        "title": "TraceAI: Check Authentication"
      },
      {
        "command": "traceai.showStorageStats",
        "title": "TraceAI: Show Storage Statistics"
      },
      {
        "command": "traceai.cleanupStorage",
        "title": "TraceAI: Cleanup Old Artifacts"
      },
      {
        "command": "traceai.migrateConfig",
        "title": "TraceAI: Migrate Config to v2.0"
      },
      {
        "command": "traceai.refreshCache",
        "title": "TraceAI: Refresh Cache"
      },
      {
        "command": "traceai.showConversation",
        "title": "TraceAI: Show Full Conversation"
      },
      {
        "command": "traceai.showCacheStats",
        "title": "TraceAI: Show Cache Stats"
      },
      {
        "command": "traceai.toggleInlineDecorations",
        "title": "TraceAI: Toggle Inline Decorations"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2"
  }
}
