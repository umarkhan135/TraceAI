# TraceAI specific
# TraceAI hook data (DO commit .traceai/config.json)
# config.json stores the Gist URL and metadata
traceai-output/
*.artifact.json
artifact.json
artifacts/
*.jsonl.bak

# Ignore .traceai cache directory (extension's offline cache)
.traceai/.cache/
.traceai/cache/

# Ignore local artifacts.json (prefer config.json which points to Gist)
.traceai/artifacts.json
.traceai/*.jsonl

# Ignore hook prompt marker (internal state tracking)
.traceai/.hook-prompted

# But DO commit config.json (created by git hooks)
!.traceai/config.json
